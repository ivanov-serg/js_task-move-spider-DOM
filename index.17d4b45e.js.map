"use strict";
var spider = document.querySelector(".spider");
var wall = document.querySelector(".wall");
document.addEventListener("click", function(e) {
    var wallRect = wall.getBoundingClientRect();
    // ignore clicks outside wall
    if (e.clientX < wallRect.left || e.clientX > wallRect.right || e.clientY < wallRect.top || e.clientY > wallRect.bottom) return;
    // ❗ враховуємо border
    var relativeX = e.clientX - wallRect.left - wall.clientLeft;
    var relativeY = e.clientY - wallRect.top - wall.clientTop;
    var spiderRect = spider.getBoundingClientRect();
    var spiderWidth = spiderRect.width;
    var spiderHeight = spiderRect.height;
    var newLeft = relativeX - spiderWidth / 2;
    var newTop = relativeY - spiderHeight / 2;
    var maxX = wall.clientWidth - spiderWidth;
    var maxY = wall.clientHeight - spiderHeight;
    if (newLeft < 0) newLeft = 0;
    if (newTop < 0) newTop = 0;
    if (newLeft > maxX) newLeft = maxX;
    if (newTop > maxY) newTop = maxY;
    spider.style.left = "".concat(newLeft, "px");
    spider.style.top = "".concat(newTop, "px");
});

